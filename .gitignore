# datasets/ is regenerable bulk EXCEPT the packed benchmark corpus, which is not:
# see datasets/GAMMA_BENCHMARK_PHASE2.md. Pattern is `datasets/*` (not `datasets/`)
# so the negation below can take effect -- git will not descend into an excluded
# DIRECTORY, so a file inside one cannot be re-included.
datasets/*

.ruff_cache/validation_results.json


*.mp4

# Local optimal-route / viz outputs (see scripts/render_optimal_route_videos.py)
optimal_route_videos/

*.gz

# Rust native build artifacts
nclone-native/target/

*.npz

# Ninja animation data is a required runtime asset (see nclone/ninja.py) —
# force-tracked despite the blanket *.bin rule above.
!anim_data_line_new.txt.bin

# The realism model's calibration is a shipped asset, not a build artifact:
# nclone/levelgen/realism.py cannot score anything without it, and regenerating
# it needs the 250k-level human corpus. Force-tracked past the *.npz rule above.
!nclone/levelgen/realism_calibration.npz

# Local experiment / analysis / render output (kept locally, not published)
ckpt/
checkpoints/
experiments/
generator_samples/
viz/
renders/
chamber_maze_analysis/
demo_gen_logs/
platform_diag/
stuck_level_renders/
precision_dumps_sample/
platform_stairs_zero_success_levels/
scratch_dumps/
videos/
bc_replays_tmp/
validation_output/

# Loose map artifacts at repo root
attract_0_map.dat
cubemap.map

# --- Excluded from VCS (kept locally) ---
# Documentation + handoffs + cursor plans
docs/
.cursor/
# Generated lattice route data
nclone/latticepaths/

# local dev-assistant skill configs
.claude/

# render3d: legacy in-tree GL symlink shims (now written to the user cache)
.gl_shims/

# Stray sim debug dumps
*_0th_replay
nclone/maps/142634
nclone/maps/142634_0.replay

# --- Re-includes. These must stay LAST: gitignore lets a later pattern override an
# earlier one, and `*.gz` above would otherwise re-exclude the packed corpus. ---
!datasets/gamma_benchmark_phase2.tar.gz
!datasets/GAMMA_BENCHMARK_PHASE2.md
